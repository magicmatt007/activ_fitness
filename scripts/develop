#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [[ ! -x "${PWD}/.venv/bin/hass" ]]; then
    echo "Run scripts/setup first." >&2
    exit 1
fi
source "${PWD}/.venv/bin/activate"

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Home Assistant only discovers custom integrations in <config>/custom_components,
# not via PYTHONPATH. Link the repo's integration there so the source of truth
# stays in <root>/custom_components while the HA config lives in <root>/config.
mkdir -p "${PWD}/config/custom_components"
if [[ ! -e "${PWD}/config/custom_components/activ_fitness" ]]; then
    ln -s "../../custom_components/activ_fitness" "${PWD}/config/custom_components/activ_fitness"
fi

# Start Home Assistant
hass --config "${PWD}/config" --debug
